# Database (local dev points at the Dockerized postgres on host port 5434).
DATABASE_URL="postgresql://cms:cms@localhost:5434/cms?schema=public"

# API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
ENABLE_SWAGGER="true"
SEED_ADMIN_PASSWORD="admin12345"

# Web (browser). Server-side fetches in Docker use API_URL instead.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_URL=http://localhost:4000/api
